step "run-a-script" {
    name = "Run a Script"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = "echo \"hello\""
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool_variable = "#{templaye.workerpool}"
    }
}

process_template "run-a-process-template" {
    name = "Run a Process Template"
    process_template_slug = "testing-template"
    version_mask = "PreRelease"

    parameter "Worker Pool" {
        value = "#{templaye.workerpool}"
    }
}