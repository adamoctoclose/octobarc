name = "Testing Template"
description = ""

parameter "Worker Pool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = ""
    label = ""
}

step "say-hello" {
    name = "Say Hello"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                echo "Hello"
                
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool_variable = "#{Worker Pool}"
    }
}

step "say-hello-again-again" {
    condition = "Variable"
    name = "Say hello again again!"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{Octopus.Space.Name}=Default"
    }

    action "manual-intervention-required" {
        action_type = "Octopus.Manual"
        is_required = true
        name = "Manual Intervention Required"
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "Dry run completely successfully. Review the artifacted changeset logic before confirming deployment"
        }
    }

    action "say-hello-again-again" {
        action_type = "Octopus.Script"
        condition = "Variable"
        name = "Say hello again again!"
        properties = {
            Octopus.Action.ConditionVariableExpression = "Octopus.Action[Manual Intervention Required].Output.Manual.Approved=True"
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = "echo \"Say hello again again!\""
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool_variable = "#{Worker Pool}"
    }
}